# .gitattributes — file handling rules for git
# Auto-detect text files (cross-platform)
* text=auto
# Force LF line endings for shell scripts (even on Windows)
*.sh text eol=lf
*.py text eol=lf
Makefile text eol=lf
# Markdown: keep as text
*.md text eol=lf
*.bib text eol=lf
# JSON / YAML / TOML: text with LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
# Binary: explicit
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.shp binary
*.shx binary
*.dbf binary
*.prj binary
*.cpg binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary
*.gguf binary
*.parquet binary
# Git LFS — only the google_open_buildings dataset files.
# These are downloaded Google Open Buildings parquet shards (publicly
# available at https://sites.research.google/open-buildings/) vendored
# so the substrate is self-contained. ~1.3 GB total.
data/raw/google_open_buildings/*.csv.gz filter=lfs diff=lfs merge=lfs -text
data/raw/google_open_buildings/paraguay_buildings.csv filter=lfs diff=lfs merge=lfs -text
