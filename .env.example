# =============================================================================
# P1 GeoData v2 — Environment Configuration
# Copy this file to .env and fill in your credentials
# =============================================================================
# NEVER commit .env to git. .env.example is safe to commit.

# -----------------------------------------------------------------------------
# 1. Hugging Face (REQUIRED for dataset + model upload)
# Get token at: https://huggingface.co/settings/tokens
# Scope needed: write
# -----------------------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_USERNAME=your-username-here
HF_DATASET_NAME=paraguay-cartography-annotated
HF_MODEL_NAME=paraguay-cartography-florence-2

# -----------------------------------------------------------------------------
# 2. Copernicus Hub / Sentinel-2 (REQUIRED for satellite imagery download)
# Register free at: https://dataspace.copernicus.eu/
# -----------------------------------------------------------------------------
COPERNICUS_USER=your-email@example.com
COPERNICUS_PASS=your-password-here

# Alternative: AWS for cloud-free Sentinel-2 mosaics (free tier)
# Register at: https://aws.amazon.com/
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 3. Google Cloud / Open Buildings (REQUIRED for Google Open Buildings v3)
# Register at: https://console.cloud.google.com/
# Activate Cloud Storage API + create service account with Storage Object Viewer
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/opt/data/thesis-active/secrets/gcp-service-account.json
GCP_BILLING_PROJECT_ID=your-gcp-project

# -----------------------------------------------------------------------------
# 4. WorldPop (FREE — no auth needed for download, but rate-limited)
# Just set your contact email for the API
# -----------------------------------------------------------------------------
WORLDPOP_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# 5. GitHub (REQUIRED for git push to your repo)
# Personal access token: https://github.com/settings/tokens
# Scope: repo (full control of private repositories)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USER=IvanWeissVanDerPol
GITHUB_REPO=paraguay-geodata-vlm

# -----------------------------------------------------------------------------
# 6. Cloudflare R2 (OPTIONAL — for hosting the web app + dataset backups)
# Get token at: https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# -----------------------------------------------------------------------------
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_R2_ACCESS_KEY=your-r2-access-key
CF_R2_SECRET_KEY=your-r2-secret-key
CF_R2_BUCKET=paraguay-geodata-vlm

# -----------------------------------------------------------------------------
# 7. arXiv (REQUIRED for paper submission)
# Get token at: https://arxiv.org/account
# -----------------------------------------------------------------------------
ARXIV_USER=your-arxiv-username
ARXIV_PASS=your-arxiv-password
ARXIV_ORCID=0000-0000-0000-0000

# -----------------------------------------------------------------------------
# 8. OpenAI / Anthropic (OPTIONAL — for LLM-assisted writing)
# Only needed if you want AI to help draft the paper
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 9. Zenodo (REQUIRED for dataset DOI on publication)
# Get token at: https://zenodo.org/account/settings/applications/tokens/new/
# -----------------------------------------------------------------------------
ZENODO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 10. UNA / Academic (NOT NEEDED until advisor co-sign phase — month 7+)
# -----------------------------------------------------------------------------
UNA_STUDENT_ID=your-una-student-id
UNA_FACULTY=FADA
UNA_PROGRAM=Maestría en Tecnología de la Arquitectura

# -----------------------------------------------------------------------------
# 11. Local services (set by docker-compose; defaults below are fine)
# -----------------------------------------------------------------------------
LABELSTUDIO_USER=ivan
LABELSTUDIO_PASS=changeme
LABELSTUDIO_DB_PASSWORD=changeme
LABELSTUDIO_HOST=http://localhost:8080

OLLAMA_HOST=http://localhost:11434
CHROMA_HOST=http://localhost:8000
BACKEND_HOST=http://localhost:8001
WEB_HOST=http://localhost:3000

MODEL_NAME=HuggingFaceTB/SmolVLM-256M-Instruct
LLM_MODEL=llama3.1:8b-instruct-q4_K_M

# -----------------------------------------------------------------------------
# 12. Thesis metadata (for paper + dataset uploads)
# -----------------------------------------------------------------------------
THESIS_AUTHOR="Iván Weiss Van der Pol"
THESIS_TITLE_ES="Anotación semiautomática con modelos multimodales del corpus cartográfico abierto de Paraguay"
THESIS_TITLE_EN="Semi-Automated Annotation of Paraguay's Open Cartographic Corpus with Multimodal Foundation Models"
THESIS_YEAR=2026
THESIS_LICENSE=CC-BY-4.0

# -----------------------------------------------------------------------------
# 13. Compute (matches docker-compose GPU reservations)
# -----------------------------------------------------------------------------
NVIDIA_VISIBLE_DEVICES=0  # set to "" for CPU-only
TORCH_DEVICE=cuda         # cuda | cpu | mps
SEED=42
NUM_WORKERS=4
BATCH_SIZE=8
GRADIENT_ACCUMULATION=4