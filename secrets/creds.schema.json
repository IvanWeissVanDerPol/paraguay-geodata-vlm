{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis-active.local/secrets/creds.schema.json",
  "title": "P1 GeoData v2 — credentials bundle schema",
  "description": "JSON Schema for validating secrets/creds.json before Erebus loads it.",
  "type": "object",
  "required": ["meta", "services"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["owner", "purpose"],
      "properties": {
        "owner": {"type": "string"},
        "filled_at": {"type": "string", "format": "date-time"},
        "purpose": {"type": "string"}
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "huggingface": {
          "type": "object",
          "properties": {
            "token": {"type": "string", "pattern": "^hf_[A-Za-z0-9_]+$"},
            "username": {"type": "string"},
            "dataset_name": {"type": "string"},
            "model_name": {"type": "string"}
          }
        },
        "copernicus": {
          "type": "object",
          "properties": {
            "user": {"type": "string"},
            "pass": {"type": "string"}
          }
        },
        "aws": {
          "type": "object",
          "properties": {
            "access_key_id": {"type": "string", "pattern": "^AKIA[A-Z0-9]+$"},
            "secret_access_key": {"type": "string", "minLength": 20},
            "region": {"type": "string"}
          }
        },
        "github": {
          "type": "object",
          "properties": {
            "token": {"type": "string", "pattern": "^(ghp_|github_pat_)[A-Za-z0-9_]+$"},
            "user": {"type": "string"},
            "repo": {"type": "string"}
          }
        },
        "cloudflare_r2": {
          "type": "object",
          "properties": {
            "account_id": {"type": "string"},
            "access_key": {"type": "string"},
            "secret_key": {"type": "string"},
            "bucket": {"type": "string"}
          }
        },
        "arxiv": {
          "type": "object",
          "properties": {
            "user": {"type": "string"},
            "pass": {"type": "string"},
            "orcid": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"}
          }
        },
        "zenodo": {
          "type": "object",
          "properties": {
            "token": {"type": "string"}
          }
        },
        "openai": {
          "type": "object",
          "properties": {
            "api_key": {"type": "string"}
          }
        },
        "anthropic": {
          "type": "object",
          "properties": {
            "api_key": {"type": "string"}
          }
        },
        "google_cloud": {
          "type": "object",
          "properties": {
            "service_account_json_path": {"type": "string"},
            "billing_project_id": {"type": "string"}
          }
        },
        "una": {
          "type": "object",
          "properties": {
            "student_id": {"type": "string"},
            "faculty": {"type": "string"},
            "program": {"type": "string"}
          }
        }
      }
    },
    "hosting": {
      "type": "object",
      "properties": {
        "platform": {"enum": ["local_only", "huggingface_spaces", "cloudflare_r2", "vps"]},
        "domain": {"type": "string"}
      }
    },
    "compute": {
      "type": "object",
      "properties": {
        "local_gpu": {"enum": ["none", "rtx_3060", "rtx_4090", "a100", "h100"]},
        "cloud_budget_usd": {"type": "number", "minimum": 0},
        "training_time_hours": {"type": "number", "minimum": 0}
      }
    }
  }
}